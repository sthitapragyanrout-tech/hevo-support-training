# Production settings. Copy to .env.prod on the server and fill in. NEVER commit .env.prod.
# docker-compose.prod.yml reads this file. See DEPLOY.md.

# --- Required ------------------------------------------------------------------------------
# Long random value. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# The site's domain (or the server's IP for a first trial). Comma-separated if several.
ALLOWED_HOSTS=training.example.com

# Database (runs in its own container; the password only needs to be strong, and should
# use letters and digits only so it fits in a URL).
POSTGRES_DB=hevo_training
POSTGRES_USER=hevo
POSTGRES_PASSWORD=

# --- HTTPS ---------------------------------------------------------------------------------
# NGINX_SITE=https  → this stack serves HTTPS itself (certificate in deploy/nginx/certs/).
# NGINX_SITE=http   → something in front already handles HTTPS, or a first trial over http.
NGINX_SITE=http
# Set to false ONLY for a first trial over plain http (by IP, no certificate yet).
USE_HTTPS=true
# Defaults to https://<each ALLOWED_HOSTS entry>. Set it if the site uses another port/scheme.
# CSRF_TRUSTED_ORIGINS=https://training.example.com
# Ports on the server. If an existing nginx already uses 80/443, see DEPLOY.md:
# BIND_ADDRESS=127.0.0.1, HTTP_PORT=8080, HTTPS_PORT=8443.
# BIND_ADDRESS=0.0.0.0
# HTTP_PORT=80
# HTTPS_PORT=443

# --- Practice tickets (AI customer) ---------------------------------------------------------
# Needed for practice tickets to run and be scored. Leave empty if not using them yet.
OPENAI_API_KEY=
# SIMBOT_MODEL=gpt-4o-mini
# SIMBOT_EVAL_MODEL=gpt-4o-mini

# --- Accounts ---------------------------------------------------------------------------------
# New users must replace their temporary password before using anything.
ENFORCE_PASSWORD_CHANGE=true
# Emergency Django Admin at /django-admin/ (superusers only). Keep on until retired.
ENABLE_DJANGO_ADMIN=true

# --- Optional tuning ---------------------------------------------------------------------------
# WEB_CONCURRENCY=3            # gunicorn processes
# MEDIA_WORKER_CONCURRENCY=1   # video conversions at once (max 2)
# SIMBOT_WORKER_CONCURRENCY=4  # practice tickets at once
# MEDIA_MAX_UPLOAD_MB=1024
# LOG_LEVEL=INFO
# SECURE_HSTS_SECONDS=3600     # raise to 31536000 once HTTPS is confirmed working

# --- Zendesk import (OFF) -----------------------------------------------------------------------
# Stays off until data-protection sign-off. Do not set these without it (docs/simbot.md).
