# Copy to .env and adjust for local dev. Never commit the real .env.

DJANGO_SECRET_KEY=django-insecure-change-me-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=hevo_training
POSTGRES_USER=hevo
POSTGRES_PASSWORD=hevo
DATABASE_URL=postgres://hevo:hevo@postgres:5432/hevo_training

REDIS_URL=redis://redis:6379/0

# --- Practice tickets from past Zendesk queries (docs/simbot.md) -------------------------
# Read-only. Importing stays OFF until a data-protection sign-off is recorded below AND a
# sample audit has been run (manage.py audit_zendesk_sample).
# ZENDESK_SUBDOMAIN=yourcompany
# ZENDESK_EMAIL=someone@yourcompany.com
# ZENDESK_API_TOKEN=            # a read-only API token; never commit it
# ZENDESK_EXCLUDE_REQUESTER_IDS=  # the old bot's Zendesk user id(s), comma-separated
# ZENDESK_EXCLUDE_GROUP_IDS=
# ZENDESK_EXCLUDE_TAGS=
# ZENDESK_STAFF_DOMAINS=yourcompany.com
# SIMBOT_ZENDESK_IMPORT_ENABLED=false
# SIMBOT_ZENDESK_SIGNOFF=       # who approved sending scrubbed customer text to the model, when, and the reference
# SIMBOT_AUTO_APPROVE=true      # false = every imported question waits for a trainer
# SIMBOT_SKIPS_PER_ACTIVITY=5
# SIMBOT_TOPUP_ENABLED=true     # false = the nightly top-up can never run; the Console switch is off until an admin turns it on
# SIMBOT_BANK_TARGET=30         # approved questions we want in the bank
# SIMBOT_TOPUP_COUNT=20         # past tickets looked at per night (max 50)
# SIMBOT_TOPUP_MAX_DRAFTS=25    # don't top up while this many drafts await review
# SIMBOT_TOPUP_PAUSE_AFTER=3    # pause after this many nights that found nothing
# SIMBOT_TOPUP_HOUR=2           # UTC
# SIMBOT_TOPUP_MINUTE=30
# OPENAI_API_KEY=            # the practice-ticket model key; put the real one in backend/.env only

# --- Mentor-rated simulations (docs/manual-simulation.md) -------------------------------------
# MANUAL_SIM_REVIEW_HOURS=48            # a mentor's review target
# MANUAL_SIM_ESCALATION_GRACE_HOURS=24  # an overdue review then opens to any rater
# MANUAL_SIM_ATTENTION_AFTER=3          # unsuccessful reviews before "needs attention"
# MANUAL_SIM_EXTEND_MAX_DAYS=14
# MANUAL_SIM_MAX_FILES=5
# MANUAL_SIM_MAX_FILE_MB=10
# MANUAL_SIM_MAX_TOTAL_MB=25
